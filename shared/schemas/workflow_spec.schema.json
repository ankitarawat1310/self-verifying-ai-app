{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowSpecDocument",
  "type": "object",
  "required": ["workflow_id", "application_name", "actors", "endpoints"],
  "properties": {
    "workflow_id": { "type": "string" },
    "application_name": { "type": "string" },
    "description": { "type": "string" },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "entities": { "type": "array" },
    "business_rules": { "type": "array" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "path", "business_action"],
        "properties": {
          "method": { "type": "string" },
          "path": { "type": "string" },
          "business_action": { "type": "string" },
          "allowed_roles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "invariants": { "type": "array", "items": { "type": "string" } }
  }
}
