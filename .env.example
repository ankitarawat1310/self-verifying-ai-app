OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Claude): set SVAGA_LLM_PROVIDER=anthropic. Default model is the cheapest/fastest current Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# LLM backend: scripted (CI/tests), openai, ollama (local, no API key), or anthropic
SVAGA_LLM_PROVIDER=scripted
SVAGA_SCRIPTED_LLM=1

# Ollama (local, native /api/chat). Install https://ollama.com then: ollama pull qwen3-coder:30b  (19 GB, needs a 24 GB GPU)
# Smaller GPUs: qwen2.5-coder:14b (12-16 GB) or qwen2.5-coder:7b (8 GB).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=6000
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=24h
# Set per repeat (1, 2, 3) to make experiment runs reproducible
SVAGA_SEED=
CHROMA_PERSIST_DIR=model1_rag_generator/backend/chroma_db
KNOWLEDGE_BASE_DIR=model1_rag_generator/backend/knowledge_base
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8000
VERIFICATION_FUZZ_SECONDS=5
MAX_REPAIR_ROUNDS=3
